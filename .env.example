APP_NAME="SILINGKAR DLH Palu"
APP_ENV=local
APP_KEY=
# Produksi WAJIB false — debug=true membocorkan env, konfigurasi, dan stack trace.
APP_DEBUG=false
APP_URL=http://localhost

# Alamat reverse proxy yang dipercaya (pisahkan dengan koma).
# Isi dengan IP/range proxy Anda (mis. range Docker "172.16.0.0/12" atau
# IP Cloudflare Tunnel). Jangan gunakan "*" di produksi.
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_TIMEZONE=Asia/Makassar
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: PostgreSQL / Neon ---
# Lokal: pakai service `db` di docker-compose.yml (host = db).
# Neon: isi DB_HOST lengkap + DB_NEON_ENDPOINT (lihat app/Providers/NeonDatabaseProvider.php).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dlh_palu
DB_USERNAME=dlh_palu
DB_PASSWORD=
DB_SSLMODE=prefer
# Khusus Neon: endpoint compute, mis. "ep-xxx-yyy" (opsional, kosongkan untuk PostgreSQL biasa)
DB_NEON_ENDPOINT=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Aktifkan (true) bila situs sudah HTTPS agar cookie session hanya dikirim
# lewat koneksi aman. Biarkan false untuk pengembangan lokal via HTTP.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Storage: Backblaze B2 (S3-compatible) ---
# Buat key di Backblaze B2 > Buckets > Application Keys.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_USE_PATH_STYLE_ENDPOINT=false

# Disk 's3' (bawaan) juga diarahkan ke B2 agar konsisten
AWS_ACCESS_KEY_ID=${B2_KEY_ID}
AWS_SECRET_ACCESS_KEY=${B2_APPLICATION_KEY}
AWS_DEFAULT_REGION=${B2_REGION}
AWS_BUCKET=${B2_BUCKET}
AWS_ENDPOINT=${B2_ENDPOINT}
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Backup Database ---
BACKUP_DISK=b2

# --- Monitoring Infrastruktur (kuota progress bar, satuan GB) ---
# Free tier default: B2 = 10 GB, Neon = 0.5 GB. Sesuaikan bila paket berubah.
B2_STORAGE_LIMIT_GB=10
NEON_STORAGE_LIMIT_GB=0.5

# Status paket/langganan tiap layanan (ditampilkan di card monitoring).
# Isi sesuai plan aktif, mis. "Free Tier", "Backblaze B2 Capillary", "Neon Scale".
B2_PLAN="Free Tier"
NEON_PLAN="Free Tier"

VITE_APP_NAME="${APP_NAME}"

# --- GPS API Integration (portal.gps.id) ---
GPS_LOGIN_URL=https://portal.gps.id/backend/api/single_login
GPS_MONITORING_URL=https://portal.gps.id/backend/seen/gps/list_monitoring
GPS_USERNAME=
GPS_PASSWORD=
GPS_PALU_DEFAULT_LAT=-0.9
GPS_PALU_DEFAULT_LNG=119.87

# --- Google Drive API (halaman publik Tata Lingkungan) ---
# Buat API key di https://console.cloud.google.com/apis/credentials
# dengan API "Google Drive API" diaktifkan, lalu isi di bawah ini.
# Folder yang dibagikan harus berstatus "Siapa pun yang memiliki link dapat melihat".
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_TATA_LINGKUNGAN_FOLDER_ID=
GOOGLE_DRIVE_CACHE_TTL=900
GOOGLE_DRIVE_MAX_DEPTH=8
