APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: Neon PostgreSQL ---
DB_CONNECTION=pgsql
DB_HOST=ep-xxxx-xxxx.c-3.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=xxxx
DB_SSLMODE=require
DB_NEON_ENDPOINT=ep-xxxx-xxxx

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# Gunakan Redis untuk performa lebih baik (butuh server Redis + ekstensi phpredis):
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-login-email@example.com
MAIL_PASSWORD=xsmtpsib-xxxxxxxxxxxxx-xxxxxxxxxxxxxxx
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-verified-email@gmail.com"
MAIL_FROM_NAME="DLH Kota Palu"

# --- Storage: Backblaze B2 (S3-compatible) ---
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_REGION=us-west-002
B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com
B2_USE_PATH_STYLE_ENDPOINT=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-002
AWS_BUCKET=
AWS_ENDPOINT=https://s3.us-west-002.backblazeb2.com
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# GPS API Integration Settings
GPS_LOGIN_URL=
GPS_MONITORING_URL=
GPS_USERNAME=
GPS_PASSWORD=
GPS_PALU_DEFAULT_LAT=-0.9
GPS_PALU_DEFAULT_LNG=119.87

# OpenRouter AI Chatbot Settings
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=tencent/hy3:free

# Google Drive API (halaman publik Tata Lingkungan)
# Buat API key di https://console.cloud.google.com/apis/credentials
# dengan API "Google Drive API" diaktifkan. Folder yang dibagikan harus
# berstatus "Siapa pun yang memiliki link dapat melihat".
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_TATA_LINGKUNGAN_FOLDER_ID=14yIelP7BkmVw7bTOl-cIyNYI1jRmLvsQ
GOOGLE_DRIVE_CACHE_TTL=900
GOOGLE_DRIVE_MAX_DEPTH=8
