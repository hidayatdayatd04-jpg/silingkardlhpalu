{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SILINGKAR DLH ADMIN",
  "mainBinaryName": "dlh-admin-desktop",
  "version": "1.0.0",
  "identifier": "com.dlhpalu.adminpanel",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "both",
        "languages": ["English", "Indonesian"],
        "displayLanguageSelector": true
      }
    }
  }
}
